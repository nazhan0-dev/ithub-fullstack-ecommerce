# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าจริง (ห้าม commit ไฟล์ .env)

# พอร์ตของ server และหน้าเว็บที่อนุญาตให้เรียก API (CORS, คั่นหลายที่ด้วย ,)
PORT=8000
CLIENT_URL=http://localhost:5173

# MySQL: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/ecom"

# ใช้เซ็น JWT ตอน login — ตั้งเป็นข้อความสุ่มยาว ๆ
SECRET=change-me-to-a-long-random-string

# Cookie ที่เก็บ token (ไม่ต้องตั้งตอนพัฒนาในเครื่อง)
#   NODE_ENV=production    -> cookie ส่งผ่าน HTTPS เท่านั้น (Secure)
#   COOKIE_SAMESITE=none   -> ใช้เมื่อหน้าเว็บกับ API อยู่คนละโดเมน (ต้องเป็น HTTPS)
# NODE_ENV=production
# COOKIE_SAMESITE=lax

# Cloudinary (อัปโหลดรูปสินค้า) — https://console.cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe secret key (ขึ้นต้นด้วย sk_test_) — https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=

# Stripe webhook signing secret (ขึ้นต้นด้วย whsec_) — สร้างคำสั่งซื้อให้แม้ลูกค้าปิดแท็บหลังจ่ายเงิน
#   ในเครื่อง: stripe listen --forward-to localhost:8000/api/stripe/webhook
#   ใช้งานจริง: Stripe Dashboard › Developers › Webhooks (event: payment_intent.succeeded)
STRIPE_WEBHOOK_SECRET=

# กันการเดารหัสผ่าน: ผิดได้กี่ครั้งใน 15 นาที (ต่ออีเมล / ต่อ IP)
# LOGIN_MAX_TRIES=5
# LOGIN_MAX_TRIES_IP=30
# อยู่หลัง reverse proxy (Render, Railway, nginx) ให้เปิด เพื่อนับตาม IP จริงของผู้ใช้
# TRUST_PROXY=true

# บัญชี admin ที่ `npm run seed` จะสร้าง (ไม่ใส่ก็ใช้ค่าเริ่มต้น)
ADMIN_EMAIL=admin@ithub.com
ADMIN_PASSWORD=Admin@1234
