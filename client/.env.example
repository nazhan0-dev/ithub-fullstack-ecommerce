# คัดลอกเป็น .env แล้วใส่ค่า (แก้แล้วต้อง restart `npm run dev`)

# ที่อยู่ API ของ server (ไม่ตั้ง = http://localhost:8000/api)
VITE_API_URL=http://localhost:8000/api

# Stripe publishable key (ขึ้นต้นด้วย pk_test_) — จำเป็น ไม่ตั้งแล้วหน้าชำระเงินจะใช้ไม่ได้
# ดูได้ที่ Stripe Dashboard › Developers › API keys
VITE_STRIPE_PUBLISHABLE_KEY=
